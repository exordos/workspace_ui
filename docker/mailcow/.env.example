# Mailcow dockerized — copy to mailcow-dockerized/mailcow.conf after generate_config.sh
# See docker/mailcow/README.md

MAILCOW_HOSTNAME=mail.example.test
MAILCOW_TZ=Europe/Moscow

# mail-proxy connection (packages/mail-proxy/.env)
MAILCOW_IMAP_HOST=127.0.0.1
MAILCOW_IMAP_PORT=993
MAILCOW_SMTP_HOST=127.0.0.1
MAILCOW_SMTP_PORT=465
MAILCOW_TLS_REJECT_UNAUTHORIZED=false
