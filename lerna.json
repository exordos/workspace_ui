{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "0.4.5",
  "npmClient": "npm",
  "packages": [".", "packages/*"],
  "command": {
    "version": {
      "message": "chore(release): v%s",
      "forcePublish": true
    },
    "run": {
      "ignore": "workspace"
    }
  }
}
