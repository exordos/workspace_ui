# packages/web — copy to `.env` or `.env.local`. Only `VITE_*` is exposed to the client.
# Full list: `src/vite-env.d.ts` · branding: `.env.brand-example`
# Default HTTP paths are gateway-first; vanilla Zulip: see `docs/adr/008-workspace-http-path-defaults.md`

# Optional static dev proxy target (multi-org: instance + `X-Workspace-Dev-Target-Origin` at runtime)
VITE_WORKSPACE_API_ORIGIN=

# Optional: path overrides when your deployment differs from defaults (omit if unsure)
# VITE_ZULIP_API_PATH=
# VITE_WORKSPACE_API_PATH=
# VITE_WORKSPACE_REST_API_PATH=
# VITE_USER_UPLOADS_PATH_PREFIX=
# VITE_USER_UPLOADS_AT_REALM_ROOT=
# VITE_USER_UPLOADS_PREFIX_ON_ZULIP_REALM=

VITE_JITSI_MEET_DOMAIN=
VITE_SENTRY_DSN=
VITE_APP_VERSION=

# Dev-only (Vite proxy request logging)
# VITE_DEV_PROXY_DEBUG=
