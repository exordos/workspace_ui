# ═══════════════════════════════════════════════════════════
#  Workspace UI — Environment Variables
# ═══════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in the values:
#    cp .env.example .env
#
#  Vite convention:
#  - VITE_* vars are exposed to the browser (client-side)
#  - Vars without VITE_ prefix are build-time only (not in bundle)
#
#  Files loaded by Vite (in order, last wins):
#    .env                 ← always loaded
#    .env.local           ← always loaded, gitignored
#    .env.development     ← only in dev mode
#    .env.production      ← only in prod build
#
# ═══════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────

# Zulip/Workspace API server origin.
# In dev: Vite proxies /workspace/* to this URL (bypass CORS); REST calls use /workspace/v1/....
# In prod: used directly for API calls.
# Example: https://zulip.example.com
# NOTE: If Workspace endpoints live on another host (e.g. workspace.example.com),
# set VITE_WORKSPACE_API_LEGACY_ORIGIN below.
VITE_WORKSPACE_API_ORIGIN=

# ── Optional ──────────────────────────────────────────────

# Jitsi Meet domain (without protocol).
# Used for video call links and JitsiMeeting component.
# Leave empty to disable video calls.
# Example: meet.example.com
VITE_JITSI_MEET_DOMAIN=

# Incoming call modal variant.
# `large` — centered modal (default), `compact` — small top-right popup.
# Any other value falls back to `large`.
# VITE_CALL_INCOMING_MODAL_VARIANT=large

# Override Workspace API base URL (with /api/v1).
# Normally auto-computed from VITE_WORKSPACE_API_ORIGIN.
# Use only if API is on a different path.
# Example: https://api.example.com/custom/path/v1
# VITE_WORKSPACE_API_BASE_URL=

# Optional origin for legacy Workspace endpoints routed as /workspace/v1 in dev proxy.
# Useful when Zulip and Workspace APIs are on different hosts.
# Example: https://workspace.example.com
# VITE_WORKSPACE_API_LEGACY_ORIGIN=

# Enable vite-plugin-pwa dev service worker in local development.
# Default is disabled to avoid stale/hashed Workbox script loading issues in Vite dev mode.
# Set to true only when explicitly debugging PWA service worker behavior.
# VITE_PWA_DEV=false

# CDN base URL for static assets (JS, CSS, images, fonts).
# When set, all assets are loaded from CDN instead of origin server.
# Trailing slash NOT needed — added automatically.
# Leave empty to serve from same origin.
# Example: https://cdn.example.com/workspace
# VITE_CDN_URL=

# Persist chat messages to IndexedDB (write-through; UI uses Zustand). Default true in dev/prod.
# Set false to disable IDB (no disk cache). Legacy alias: VITE_CHAT_MESSAGES_SOURCE_INDEXEDDB.
# VITE_CHAT_MESSAGES_PERSIST_INDEXEDDB=true

# Verbose `[message-flow]` / `[folder-flow]` traces in browser console (#seq +ms order; default on in dev).
# VITE_MESSAGE_FLOW_DEBUG=true

# ── Embedding ─────────────────────────────────────────────

# Comma-separated list of origins allowed for iframe embedding.
# Jitsi and Workspace origins are always allowed automatically.
# Example: https://wiki.example.com,https://grafana.internal.com
# VITE_EMBED_ALLOWED_ORIGINS=

# Calendar and Mail embed URLs.
# If empty, Workspace UI falls back to local demo HTML pages:
# /embeds/calendar-placeholder.html and /embeds/mail-placeholder.html.
# Use absolute URLs for external services and add their origins to
# VITE_EMBED_ALLOWED_ORIGINS.
# VITE_CALENDAR_EMBED_URL=
# VITE_MAIL_EMBED_URL=

# ── API paths ─────────────────────────────────────────────

# Zulip API base path. Default: /api/v1
# Override if using a custom API gateway or reverse proxy.
# Example: /zulip-proxy/api/v2
# VITE_ZULIP_API_PATH=/api/v1

# Workspace API base path. Default: /api/v1
# Override if Workspace backend uses a different path.
# In dev, /workspace/v1 requests are also proxied (for legacy backend parity).
# Example: /workspace/v1
# VITE_WORKSPACE_API_PATH=/api/v1

# ── Monitoring ────────────────────────────────────────────

# Sentry DSN for error tracking and performance monitoring.
# Disabled in dev by default. Leave empty to disable.
# Example: https://abc123@o456.ingest.sentry.io/789
# VITE_SENTRY_DSN=

# App version for Sentry releases. Usually set by CI.
# Example: 0.1.0
# VITE_APP_VERSION=

# ── White-label branding ──────────────────────────────────
#
# Override these to rebrand the app without code changes.
# All have defaults — omit to use "Workspace" branding.
#
# VITE_BRAND_APP_NAME=Workspace
# VITE_BRAND_SHORT_NAME=Workspace
# VITE_BRAND_DESCRIPTION=Corporate messenger
# VITE_BRAND_COPYRIGHT=© 2025 Workspace Team
# VITE_BRAND_COMPANY=Workspace
# VITE_BRAND_APP_ID=com.workspace.app
# VITE_BRAND_LOGO_URL=/favicon.svg
# VITE_BRAND_SUPPORT_URL=
# VITE_BRAND_TERMS_URL=
# VITE_BRAND_PRIVACY_URL=
# VITE_BRAND_DEFAULT_PALETTE=blue-cold
# VITE_BRAND_DEFAULT_THEME=light
# VITE_BRAND_THEME_COLOR=#1B1B1D
# VITE_BRAND_BG_COLOR=#1B1B1D
# VITE_BRAND_ACCENT_COLOR=#FF8438
# VITE_BRAND_UPDATE_URL=https://update.workspace.example.com/releases
# VITE_BRAND_ALLOW_REGISTRATION=false
# VITE_BRAND_SHOW_POWERED_BY=false

# ── Analytics ──────────────────────────────────────────────

# Google Analytics 4 measurement ID.
# Enables GA4 tracking (page views, events, user properties).
# Leave empty to disable. Requires user consent before sending data.
# Example: G-XXXXXXXXXX
# VITE_GA4_MEASUREMENT_ID=

# Yandex Metrika counter ID (numeric).
# Enables Yandex Metrika tracking (goals, hits, webvisor).
# Leave empty to disable. Requires user consent before sending data.
# Example: 12345678
# VITE_YM_COUNTER_ID=

# ── Push Notifications (Firebase Cloud Messaging) ─────────

# Firebase project credentials for FCM web push.
# All 5 values must be set to enable push notifications.
# Get them from Firebase Console → Project Settings → General + Cloud Messaging.
# Leave empty to disable push (falls back to long-polling only).
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# VAPID key for web push.
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates.
# VITE_FIREBASE_VAPID_KEY=

# ── Build-time only (not exposed to browser) ──────────────

# Set to "1" when building for Electron desktop app.
# Disables PWA (service worker, manifest), switches to HashRouter.
# Used by: vite.config.ts, electron build scripts.
# ELECTRON=1
