<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Inherited entitlements for child processes (renderer, GPU, utility).
         These inherit the parent's code signing identity but may have
         a reduced set of entitlements for security. -->

    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Renderer needs network for API calls -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
