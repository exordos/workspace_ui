{
  "name": "exordos-workspace",
  "version": "0.4.12",
  "private": true,
  "description": "Exordos Workspace desktop app",
  "author": "Exordos <info@genesis-corporation.ru>",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "desktopName": "exordos-workspace.desktop",
  "homepage": "https://genesis-corporation.ru/",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:electron",
    "build:with-updates": "npm run build:web && npm run build:electron:with-updates",
    "build:web": "cd ../web && npx cross-env ELECTRON=1 vite build",
    "build:electron": "npx cross-env ELECTRON_DISABLE_AUTO_UPDATE=1 node scripts/build.mjs",
    "build:electron:with-updates": "node scripts/build.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --publish never --linux",
    "package:win:with-updates": "npm run build:with-updates && electron-builder --win --publish never",
    "package:mac:with-updates": "npm run build:with-updates && electron-builder --mac --publish never",
    "package:linux:with-updates": "npm run build:with-updates && electron-builder --publish never --linux",
    "package:appimage": "npx cross-env ELECTRON_DISABLE_AUTO_UPDATE=1 npm run build && electron-builder --linux AppImage --publish never",
    "package:appimage:with-updates": "npm run build:with-updates && electron-builder --linux AppImage --publish never",
    "bake:icons": "node scripts/bake-icon-assets.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "electron": "42.4.0",
    "electron-builder": "26.15.2",
    "esbuild": "0.28.0",
    "typescript": "6.0.3"
  }
}
