{
  "name": "electron-app",
  "version": "0.1.0",
  "private": true,
  "description": "Exordos Workspace desktop app",
  "author": "Exordos <info@genesis-corporation.ru>",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "homepage": "https://genesis-corporation.ru/",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "cd ../web && npx cross-env ELECTRON=1 vite build",
    "build:electron": "npx cross-env ELECTRON_DISABLE_AUTO_UPDATE=1 node scripts/build.mjs",
    "build:electron:with-updates": "node scripts/build.mjs",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:appimage": "npx cross-env ELECTRON_DISABLE_AUTO_UPDATE=1  npm run build && electron-builder --linux AppImage",
    "package:appimage:with-updates": "npm run build && electron-builder --linux AppImage",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "6.8.3"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "electron": "42.1.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.0",
    "typescript": "6.0.3"
  }
}
