# Electron package (packages/electron) — build-time / CI
#
# Renderer (React) reads Vite env from packages/web: .env, .env.production, .env.local
# Web production build for desktop: npm run build:web  →  cross-env ELECTRON=1 vite build
# (ELECTRON=1 is set by the script; do not rely on putting it in this file for local web dev.)

# --- Main process (esbuild define) ---
# When set to 1 / true / yes: disable electron-updater periodic checks and publish URL requests.
# ELECTRON_DISABLE_AUTO_UPDATE=

# --- Code signing & notarization (CI / release machines) ---
# macOS signing: base64 .p12 or path — see electron-builder.yml
# CSC_LINK=
# CSC_KEY_PASSWORD=
#
# macOS notarization (scripts/notarize.mjs):
# APPLE_ID=
# APPLE_APP_PASSWORD=
# APPLE_TEAM_ID=
#
# Windows: optional CSC_* for signing; see comments in electron-builder.yml
